# Copy to .env.local for local development. REACT_APP_* values are inlined
# into the client bundle at build time, so never put secrets here.

# Backend base URL, no trailing slash.
# Default when unset: /api (production, via the vercel.json rewrite).
# Local dev against a local backend (student-helper-backend on port 3080):
REACT_APP_API_URL=http://localhost:3080

# Show admin/content tools (/insert_objective, /set_objectives,
# /parse_structure, Pastpaper Edit Topics/Structure) and dev pages
# (/sentence_similarity, /home) in a production build. Always on in dev.
# REACT_APP_ENABLE_ADMIN=false

# Show the quiz entry button in a production build. Always on in dev.
# REACT_APP_ENABLE_QUIZ=false

# Google OAuth Client ID (public). Optional: src/config.js defaults to this
# same ID, so preview builds work without setting it.
REACT_APP_GOOGLE_CLIENT_ID=995518297301-i1oc3sr8173t9gsc9s5br70jl7gj5h8u.apps.googleusercontent.com

# Email address shown on /privacy for account-deletion requests. Required
# before go-live; the privacy page shows a gap until it is set.
# REACT_APP_PRIVACY_CONTACT_EMAIL=
